DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: sincronização imediata dos comandos em um servidor (ID numérico).
DISCORD_GUILD_ID=
# Opcional se houver mais de uma categoria cujo nome contenha “farme”.
FARME_CATEGORY_ID=
# IDs de canais/cargos encontrados são preenchidos automaticamente ao conectar.
PANEL_CHANNEL_ID=
ABSENCE_CHANNEL_ID=
# Canal que recebe os cadastros do formulário de identificação.
IDENTIFICATION_CHANNEL_ID=
# Opcional se o cargo de gerente tiver outro nome que não Gerente/Gerentes.
IDENTIFICATION_MANAGER_ROLE_ID=
ROLE_LEADER_ID=
ROLE_SUB_LEADER_ID=
ROLE_FARME_RESP_ID=
# Optional; auto-detected when exactly one role is named Admin/ADM/Administrador.
META_ADMIN_ROLE_ID=
# When this list is set, only these role IDs may reset the family goal.
META_ADMIN_ROLE_IDS=
# Restricts /painel-meta to the dedicated Farme control channel.
META_PANEL_CHANNEL_ID=
LOG_LEVEL=INFO
# Leave blank for local use. On a cloud VM, set a persistent path such as /var/lib/stryke-bot.
STRYKE_DATA_DIR=
